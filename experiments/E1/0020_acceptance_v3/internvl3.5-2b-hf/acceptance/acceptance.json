    "n_min": 300,
    "take": "all",
    "rule": "受限字母读数（1 个 token）的四个任务合为一组：开发子集 250 + 12 + 50 + 50 = 362 条，统计量是池内 0/1 的均值。"
   },
   {
    "name": "polygon",
    "tasks": [
     "refexp_poly"
    ],
    "metric": "cIoU",
    "metric_class": "iou",
    "n_min": 500,
    "take": 500,
    "rule": "RefCOCO、RefCOCO+、RefCOCOg 三个开发子集共 600 句，取 500 句；统计量 cIoU（ratio of sums）。"
   },
